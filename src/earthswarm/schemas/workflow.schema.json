{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openearth.local/schemas/workflow.schema.json",
  "title": "Open Earth Workflow Manifest",
  "type": "object",
  "required": ["name", "description", "steps"],
  "additionalProperties": true,
  "properties": {
    "slug": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "agent": { "type": "string" },
          "task": { "type": "string" },
          "produces": { "type": "array", "items": { "type": "string" } },
          "max_workers": { "type": "integer", "minimum": 1 },
          "parallel": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["agent"],
              "additionalProperties": true,
              "properties": {
                "agent": { "type": "string" },
                "task": { "type": "string" },
                "produces": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "anyOf": [
          { "required": ["agent"] },
          { "required": ["parallel"] }
        ]
      }
    }
  }
}
