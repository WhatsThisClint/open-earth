{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openearth.local/schemas/mcp.schema.json",
  "title": "Open Earth MCP Server Manifest",
  "type": "object",
  "required": ["name", "transport"],
  "additionalProperties": true,
  "properties": {
    "slug": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "transport": {
      "type": "string",
      "enum": ["stdio", "local", "sse", "streamable_http", "hosted"]
    },
    "enabled": { "type": "boolean" },
    "command": { "type": ["string", "null"] },
    "args": { "type": "array", "items": { "type": "string" } },
    "url": { "type": ["string", "null"] },
    "env": { "type": "object", "additionalProperties": { "type": "string" } },
    "headers": { "type": "object", "additionalProperties": { "type": "string" } },
    "timeout_seconds": { "type": "integer", "minimum": 1 },
    "cache_tools": { "type": "boolean" },
    "approval": { "type": "string", "enum": ["ask", "always", "never"] },
    "tool_policy": { "type": "object" },
    "notes": { "type": "string" }
  }
}
