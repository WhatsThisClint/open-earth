# Copy this file to .env and fill only the providers you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Optional live backend choices.
EARTHSWARM_CODEX_COMMAND=codex
EARTHSWARM_CODEX_MODEL=gpt-5.5
EARTHSWARM_HOME=

# Optional OpenAI-compatible local/provider endpoints.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional local MCP examples.
QGIS_MCP_COMMAND=qgis-mcp
QGIS_MCP_URL=http://localhost:8000/mcp
